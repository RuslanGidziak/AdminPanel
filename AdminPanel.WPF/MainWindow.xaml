<Window x:Class="AdminPanel.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdminPanel — головна" Width="640" Height="400" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}">

    <!-- Роль: стартова сторінка з переходом на сторінку ролі через меню -->
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <!-- ЗАВДАННЯ ii: пункт видно лише адміністратору -->
            <MenuItem Header="_Адміністрування"
                      Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="_Керування користувачами" Click="MenuUsers_Click" />
            </MenuItem>
            <!-- Роль: може розлогуватися -->
            <MenuItem Header="_Обліковий запис">
                <MenuItem Header="_Вийти" Click="MenuLogout_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock>
                <Run Text="Ви увійшли як" />
                <Run Text="{Binding UserName, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="·" />
                <Run Text="{Binding RoleText, Mode=OneWay}" />
            </TextBlock>
        </StatusBar>

        <StackPanel Margin="24">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,16"
                       Text="Це стартова сторінка. Перейти на сторінку своєї ролі можна через меню." />

            <!-- ЗАВДАННЯ ii: блок лише для адміністратора -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Панель адміністратора" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                               Text="Меню «Адміністрування → Керування користувачами»: таблиця, пошук, сортування, активація та блокування." />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>