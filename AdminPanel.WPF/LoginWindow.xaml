<Window x:Class="AdminPanel.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вхід" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=txtLogin}">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock Text="Вхід до системи" Style="{StaticResource TitleText}" />
            <Label Content="_Логін:" Target="{Binding ElementName=txtLogin}" Padding="0,0,0,3" />
            <TextBox x:Name="txtLogin" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
            <Label Content="_Пароль:" Target="{Binding ElementName=pwdPassword}" Padding="0,8,0,3" />
            <PasswordBox x:Name="pwdPassword" />
            <TextBlock Style="{StaticResource ErrorText}" Margin="0,8,0,0" Text="{Binding ErrorMessage}" />
            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Реєстрація" Style="{StaticResource PrimaryButton}"
                        Background="Gray" Click="BtnRegister_Click" />
                <Button DockPanel.Dock="Right" Content="Увійти" Style="{StaticResource PrimaryButton}"
                        Margin="0" IsDefault="True" Click="BtnLogin_Click" />
            </DockPanel>
            <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0" FontSize="11"
                       Text="Перший запуск: admin / Admin123!" />
        </StackPanel>
    </Border>
</Window>