<!-- Вікно реєстрації. Новий акаунт чекає активації адміністратором -->
<Window x:Class="AdminPanel.WPF.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AdminPanel.ViewModels;assembly=AdminPanel.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RegisterViewModel}"
        Title="Реєстрація" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=txtLogin}">

    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock Text="Новий обліковий запис" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10"
                       Text="Увійти можна буде після активації адміністратором." />

            <!-- ЗАВДАННЯ vi: логін перевіряється під час введення (довжина, символи) -->
            <Label Content="_Логін:" Target="{Binding ElementName=txtLogin}" Padding="0,0,0,3" />
            <TextBox x:Name="txtLogin" MaxLength="50" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

            <Label Content="_Пароль:" Target="{Binding ElementName=pwdPassword}" Padding="0,8,0,3" />
            <PasswordBox x:Name="pwdPassword" />

            <Label Content="П_ідтвердження пароля:" Target="{Binding ElementName=pwdConfirm}" Padding="0,8,0,3" />
            <PasswordBox x:Name="pwdConfirm" />

            <TextBlock Style="{StaticResource ErrorText}" Margin="0,8,0,0" Text="{Binding ErrorMessage}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Зареєструватися" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="BtnRegister_Click" />
                <Button Content="Скасувати" Padding="12,4" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>